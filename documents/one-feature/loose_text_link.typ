// Loose text, not a paragraph of its own, with bold text and a link in it. It has to stay
// one paragraph, not end at the link.
#set document(title: "Loose text")
#set text(lang: "en")
#pad(left: 1cm)[Loose text with *bold* and a #link("https://example.org")[link] in it.]

#quote(block: true)[Quoted with _emphasis_ inside.]
